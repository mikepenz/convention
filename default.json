{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "group:recommended",
    "security:openssf-scorecard"
  ],
  "pinDigests": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on Monday"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": false,
    "minimumReleaseAge": "0 days"
  },
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 6am on Monday"
  ],
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "groupName": "Gradle Wrapper"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "platformAutomerge": false,
      "groupName": "Node devDependency non-major updates",
      "labels": [
        "dependencies",
        "javascript"
      ]
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin[.:]/"
      ],
      "groupName": "Kotlin",
      "labels": [
        "dependencies",
        "kotlin"
      ]
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlinx[.:]/"
      ],
      "groupName": "Kotlinx",
      "labels": [
        "dependencies",
        "kotlin"
      ]
    },
    {
      "matchPackageNames": [
        "/^com\\.android[.:]/",
        "!/^com\\.android\\.compose\\.screenshot/"
      ],
      "groupName": "Android Gradle Plugin",
      "labels": [
        "dependencies",
        "android"
      ]
    },
    {
      "matchPackageNames": [
        "/^androidx\\.compose[.:]/",
        "/^androidx\\.wear\\.compose[.:]/"
      ],
      "groupName": "AndroidX Compose",
      "labels": [
        "dependencies",
        "android",
        "compose"
      ]
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.compose$/",
        "/^org\\.jetbrains\\.compose[.:]/",
        "!/^org\\.jetbrains\\.compose\\.hot-reload/"
      ],
      "groupName": "Compose Multiplatform",
      "labels": [
        "dependencies",
        "compose"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "automerge": true,
      "groupName": "GitHub Actions updates",
      "labels": [
        "dependencies",
        "github-actions"
      ]
    },
    {
      "matchPackageNames": [
        "/^mikepenz\\//",
        "/^(com|dev)\\.mikepenz[.:]/"
      ],
      "groupName": "Mike Penz Internal Projects",
      "automerge": true,
      "platformAutomerge": true,
      "schedule": [
        "at any time"
      ]
    }
  ]
}
